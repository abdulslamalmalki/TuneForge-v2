# Local development defaults. Do not copy these unchanged to a public server.
TUNEFORGE_ENVIRONMENT=development
TUNEFORGE_AUTH_MODE=required
TUNEFORGE_AUTH_COOKIE_SECURE=0
TUNEFORGE_AUTH_SESSION_HOURS=12
TUNEFORGE_TRUSTED_HOSTS=127.0.0.1,localhost
TUNEFORGE_MAX_PDF_PAGES=5000
TUNEFORGE_RATE_LIMIT_ENABLED=0
TUNEFORGE_RATE_LIMIT_LOGIN=10/300
TUNEFORGE_RATE_LIMIT_ASK=30/60
TUNEFORGE_RATE_LIMIT_RESEARCH=10/60
TUNEFORGE_RATE_LIMIT_PUBLIC_UPLOAD=5/3600
TUNEFORGE_RATE_LIMIT_CURATOR_UPLOAD=60/3600
TUNEFORGE_RATE_LIMIT_SEARCH=120/60
TUNEFORGE_RATE_LIMIT_ADMIN_MUTATION=120/60
TUNEFORGE_LOG_LEVEL=INFO
TUNEFORGE_LOG_FORMAT=text
KNOWLEDGE_BUILDER_DATA_DIR=./data
# Store recovery archives outside the application data volume in production.
TUNEFORGE_BACKUPS_DIR=./data/backups
TUNEFORGE_SQLITE_BUSY_TIMEOUT_SECONDS=30
TUNEFORGE_SQLITE_JOURNAL_MODE=wal
# Exact trusted reverse-proxy addresses/CIDRs passed to Uvicorn by the container.
TUNEFORGE_FORWARDED_ALLOW_IPS=127.0.0.1
# Optional, opt-in trusted-web research. These defaults use the same constrained
# HTML search endpoint as provenance discovery; result URLs are still filtered
# through TuneForge's hard-coded official-domain policy.
TUNEFORGE_TRUSTED_WEB_SEARCH_ENDPOINT=https://lite.duckduckgo.com/lite/
TUNEFORGE_TRUSTED_WEB_TIMEOUT_SECONDS=8

# Optional citation-locked presentation model. Leave provider empty for the
# deterministic, no-cost product path. Never commit a real API key.
TUNEFORGE_LLM_PROVIDER=
TUNEFORGE_LLM_MODEL=
TUNEFORGE_LLM_API_KEY=
TUNEFORGE_LLM_BASE_URL=
TUNEFORGE_LLM_TIMEOUT_SECONDS=20
TUNEFORGE_LLM_MAX_RESPONSE_BYTES=262144

# Supported providers:
#   openai             official Responses API; API key required
#   anthropic          official Messages API; API key required
#   gemini             official generateContent API; API key required
#   openai_compatible  configured /v1-compatible endpoint; key optional
# Example local endpoint (provider=openai_compatible):
# TUNEFORGE_LLM_BASE_URL=http://127.0.0.1:11434/v1

# A production deployment must use:
# TUNEFORGE_ENVIRONMENT=production
# TUNEFORGE_AUTH_COOKIE_SECURE=1
# TUNEFORGE_TRUSTED_HOSTS=tuneforge.example.com
# TUNEFORGE_RATE_LIMIT_ENABLED=1
# TUNEFORGE_LOG_FORMAT=json
